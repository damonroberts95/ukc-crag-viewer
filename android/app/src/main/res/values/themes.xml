<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Material 3, day/night by the OS. On Android 12+ DynamicColors repaints
      this from the wallpaper, so nothing here hardcodes chrome colours; these
      values are only the fallback for older phones.
    -->
    <style name="Theme.UkcCrags" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="Widget.UkcCrags.Toolbar" parent="Widget.Material3.Toolbar.Surface" />
</resources>
