<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- UKC's "near me" asks for a real fix; coarse alone often never settles. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
        The app updates itself from its own GitHub releases: there is no Play
        listing to do it. Handing an APK to the package installer needs this.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- A region-wide import runs for minutes; the count goes in the shade so
         the phone can be put down. Declined, the on-screen progress still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UkcCrags">

        <activity
            android:name=".CragListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowseActivity"
            android:parentActivityName=".CragListActivity"
            android:exported="false" />

        <activity
            android:name=".TopoActivity"
            android:exported="false" />

        <activity
            android:name=".CragActivity"
            android:parentActivityName=".CragListActivity"
            android:exported="false" />

        <activity
            android:name=".SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ListsActivity"
            android:exported="false" />

        <activity
            android:name=".MapActivity"
            android:exported="false" />

        <!--
            Lets the package installer read a downloaded APK out of the cache
            directory. Not exported: the URI is handed out per intent with a
            read grant, so nothing can go looking on its own.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

    </application>

</manifest>
